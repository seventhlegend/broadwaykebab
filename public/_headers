# Pages determines Content-Type from the static file extension.
# Header route patterns must start with / (or an absolute https:// URL).
# Do not use bare extension patterns such as *.css: duplicate headers are merged.

# Global security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Next.js assets contain a content hash in their filenames.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
